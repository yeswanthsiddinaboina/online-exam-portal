# Flask Configuration
FLASK_APP=backend/app.py
FLASK_ENV=development
SECRET_KEY=super-secret-dev-key-change-in-production

# Database Connection (MySQL or SQLite fallback)
DATABASE_URL=sqlite:///D:/secure-exam-system/secure_exam.db

# Evidence Storage Directory
EVIDENCE_DIR=D:/secure-exam-system/evidence

# Security Limits defaults
VIOLATION_HEAD_TURN_LIMIT=5
VIOLATION_TAB_SWITCH_LIMIT=3
VIOLATION_MULTIPLE_PERSON_LIMIT=3
VIOLATION_MOBILE_LIMIT=2
VIOLATION_FULLSCREEN_EXIT_LIMIT=3
COOLDOWN_SECONDS=10
HEARTBEAT_INTERVAL=5
NETWORK_GRACE_PERIOD=30
